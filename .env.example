# Local-only Document Intelligence configuration. Do not put credentials here.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
MINILM_PATH=models/minilm
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180

# Conservative local workload limits.
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_MAX_PAGES=300
DOCUMENT_MAX_CHARS=350000
DOCUMENT_EXTRACTION_BATCH_PAGES=10
DOCUMENT_EMBEDDING_BATCH_SIZE=32
DOCUMENT_MAX_CHUNKS=600
DOCUMENT_MAX_CONCURRENT_JOBS=1
DOCUMENT_MAX_PENDING_JOBS=4
